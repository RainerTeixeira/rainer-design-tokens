      "sm": "{primitives.spacing.4}",
      "md": "{primitives.spacing.6}",
      "lg": "{primitives.spacing.8}",
      "xl": "{primitives.spacing.12}"
    },
    "container": {
      "padding": "{primitives.spacing.6}",
      "maxWidth": "{primitives.layout.container.xl}"
    },
    "section": {
      "padding": "{primitives.spacing.12} {primitives.spacing.6}",
      "gap": "{primitives.spacing.8}"
    }
  },
