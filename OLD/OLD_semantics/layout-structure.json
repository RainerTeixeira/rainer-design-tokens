  "layout": {
    "padding": {
      "xs": "{primitives.spacing.2}",
      "sm": "{primitives.spacing.4}",
      "md": "{primitives.spacing.6}",
      "lg": "{primitives.spacing.8}",
      "xl": "{primitives.spacing.12}"
    },
    "margin": {
