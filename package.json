{
  "name": "@rainer/design-tokens",
  "version": "3.0.0",
  "description": "Sistema profissional de design tokens seguindo padrões W3C e melhores práticas da indústria - Versão 3.0.0 com estrutura modular e tokens primitivos/semânticos",
  "author": "Rainer Teixeira <suporte@rainersoft.com.br>",
  "license": "MIT",
  "keywords": [
    "design-tokens",
    "w3c",
    "dtcg",
    "design-tokens-community-group",
    "tailwind",
    "react",
    "nextjs",
    "design-system",
    "tokens",
    "css",
    "typescript",
    "primitive-tokens",
    "semantic-tokens",
    "theme",
    "dark-mode",
    "8pt-grid",
    "modular-scale"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./css": {
      "types": "./dist/css.d.ts",
      "import": "./dist/css.mjs",
      "require": "./dist/css.js"
    },
    "./tailwind": {
      "types": "./dist/tailwind.d.ts",
      "import": "./dist/tailwind.mjs",
      "require": "./dist/tailwind.js"
    },
    "./formats/css-vars.css": "./formats/css-vars.css",
    "./formats/tailwind.config": {
      "types": "./formats/tailwind.config.d.ts",
      "import": "./formats/tailwind.config.ts",
      "require": "./formats/tailwind.config.ts"
    },
    "./formats/tokens.json": "./formats/tokens.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "formats",
    "tokens",
    "themes",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm run build:formats && tsup",
    "build:formats": "tsx scripts/build-formats.ts",
    "build:css": "tsx scripts/build-css.ts",
    "build:tailwind": "tsx scripts/build-tailwind.ts",
    "build:tokens-json": "tsx scripts/build-tokens-json.ts",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prepare:publish": "node scripts/prepare-publish.js",
    "prepublishOnly": "pnpm run build && pnpm run type-check",
    "clean": "node -e \"require('fs').rmSync('dist', {recursive: true, force: true})\"",
    "prepublish": "pnpm run clean && pnpm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "update:dates": "tsx scripts/update-dates.ts",
    "setup": "pnpm install",
    "setup:clean": "pnpm run clean:all && pnpm install",
    "clean:all": "pnpm exec rimraf node_modules pnpm-lock.yaml dist .storybook-build"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.0.8",
    "@storybook/addon-onboarding": "^10.0.8",
    "@storybook/react-vite": "^10.0.8",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.45",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "eslint": "^9.39.1",
    "eslint-plugin-storybook": "^10.0.8",
    "jest": "^29.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "storybook": "^10.0.8",
    "ts-jest": "^29.1.1",
    "tsup": "^8.0.1",
    "tsx": "^4.20.6",
    "typescript": "^5.3.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RainerTeixeira/rainer-design-tokens.git"
  },
  "bugs": {
    "url": "https://github.com/RainerTeixeira/rainer-design-tokens/issues"
  },
  "homepage": "https://github.com/RainerTeixeira/rainer-design-tokens#readme"
}
