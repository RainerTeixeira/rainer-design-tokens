{
  "name": "@rainersoft/design-tokens",
  "version": "2.8.0",
  "description": "Design tokens globais (CSS Variables, Tailwind config, temas) para o ecossistema Rainersoft",
  "author": {
    "name": "Rainer Teixeira",
    "email": "suporte@rainersoft.com.br"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "keywords": [
    "design-tokens",
    "css-variables",
    "tailwind",
    "design-system",
    "themes",
    "dark-mode"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./src/css-vars.css": "./src/css-vars.css",
    "./formats/css-vars.css": "./formats/css-vars.css",
    "./formats/tokens.json": "./formats/tokens.json",
    "./formats/tailwind.config": "./formats/tailwind.config.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "formats",
    "README.md"
  ],
  "scripts": {
    "build": "npx tsx scripts/build-tokens.ts && tsup",
    "dev": "tsup --watch",
    "lint": "eslint . --ext ts,tsx",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "clean": "rimraf dist node_modules pnpm-lock.yaml",
    "type-check": "tsc --noEmit",
    "validate": "npx tsx scripts/release-package.ts --validate-only",
    "publish": "npx tsx scripts/release-package.ts",
    "publish:dry-run": "npx tsx scripts/release-package.ts --dry-run",
    "setup-github": "npx tsx scripts/release-package.ts --github-only",
    "sync": "npx tsx scripts/sync-docs.ts",
    "sync:version": "npx tsx scripts/sync-docs.ts --version-only",
    "sync:dates": "npx tsx scripts/sync-docs.ts --dates-only",
    "sync:readme": "npx tsx scripts/sync-docs.ts --readme-only",
    "sync:docs": "npx tsx scripts/sync-docs.ts --docs-only",
    "generate-tokens": "npx tsx scripts/build-tokens.ts",
    "generate-radius": "npx tsx scripts/build-tokens.ts",
    "generate-breakpoints": "npx tsx scripts/build-tokens.ts",
    "generate-z-index": "npx tsx scripts/build-tokens.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.6.15",
    "@storybook/builder-vite": "^8.6.15",
    "@storybook/react": "^8.6.15",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/jest": "^29.5.11",
    "@types/minimatch": "^6.0.0",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "autoprefixer": "^10.4.23",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "rimraf": "^5.0.5",
    "storybook": "^8.6.15",
    "tailwindcss": "^4.0.0",
    "ts-jest": "^29.1.1",
    "tsup": "^8.0.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "5.4.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RainerTeixeira/rainer-design-tokens.git"
  },
  "bugs": {
    "url": "https://github.com/RainerTeixeira/rainer-design-tokens/issues"
  },
  "homepage": "https://github.com/RainerTeixeira/rainer-design-tokens#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
