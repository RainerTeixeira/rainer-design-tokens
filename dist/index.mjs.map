    },
    "gradient": {
      "cyberpunk": {
        "primary": "linear-gradient(135deg, #0891b2, #2563eb, #8b5cf6)",
        "secondary": "linear-gradient(135deg, #dc2626, #ea580c)",
        "tertiary": "linear-gradient(135deg, #059669, #0891b2)",
        "background": "linear-gradient(135deg, #030712, #111827, #0f172a)"
      },
      "neon": {
        "cyan": "linear-gradient(135deg, #22d3ee, #0891b2)",
        "rose": "linear-gradient(135deg, #fca5a5, #dc2626)",
        "emerald": "linear-gradient(135deg, #6ee7b7, #059669)"
      }
    }
  },
  "shadow": {
    "neon": {
      "cyan": "0 0 20px rgba(6, 182, 212, 0.60), 0 0 40px rgba(6, 182, 212, 0.40)",
      "rose": "0 0 20px rgba(244, 63, 94, 0.60), 0 0 40px rgba(244, 63, 94, 0.40)",
      "emerald": "0 0 20px rgba(16, 185, 129, 0.60), 0 0 40px rgba(16, 185, 129, 0.40)",
      "violet": "0 0 20px rgba(139, 92, 246, 0.60), 0 0 40px rgba(139, 92, 246, 0.40)"
    },
    "glow": {
      "soft": "0 0 10px rgba(6, 182, 212, 0.30)",
      "medium": "0 0 20px rgba(6, 182, 212, 0.50)",
      "strong": "0 0 30px rgba(6, 182, 212, 0.70)"
    }
  },
