{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$description": "Dark Cyberpunk Theme - Tema escuro futurista com estética cyberpunk",
  "_comments": {
    "color": "Tema dark cyberpunk com cores neon, gradientes e alta contraste"
  },
  "color": {
    "background": {
      "primary": "{palette.gray.950}",
      "secondary": "{palette.gray.900}",
      "tertiary": "{palette.gray.800}",
      "disabled": "{palette.gray.850}",
      "overlay": "rgba(0, 0, 0, 0.85)",
      "inverse": "{palette.gray.50}",
      "glass": "rgba(15, 23, 42, 0.6)",
      "neon": "rgba(6, 182, 212, 0.1)"
    },
    "text": {
      "primary": "{palette.gray.50}",
      "secondary": "{palette.gray.300}",
      "tertiary": "{palette.gray.400}",
      "disabled": "{palette.gray.500}",
      "inverse": "{palette.gray.950}",
      "onPrimary": "{palette.gray.950}",
      "onSecondary": "{palette.gray.50}",
      "link": "{palette.cyan.400}",
      "linkHover": "{palette.cyan.300}",
      "neon": "{palette.cyan.400}",
      "neonGlow": "{palette.cyan.300}"
    },
    "button": {
      "primary": {
        "default": "{palette.cyan.600}",
        "hover": "{palette.cyan.500}",
        "active": "{palette.cyan.400}",
        "text": "{palette.gray.950}",
        "glow": "rgba(6, 182, 212, 0.5)"
      },
      "secondary": {
        "default": "{palette.gray.700}",
        "hover": "{palette.gray.600}",
        "active": "{palette.gray.500}",
        "text": "{palette.gray.50}",
        "border": "{palette.cyan.600}"
      },
      "tertiary": {
        "default": "{palette.transparent}",
        "hover": "{palette.gray.800}",
        "active": "{palette.gray.700}",
        "text": "{palette.cyan.400}",
        "border": "{palette.cyan.600}"
      },
      "danger": {
        "default": "{palette.rose.600}",
        "hover": "{palette.rose.500}",
        "active": "{palette.rose.400}",
        "text": "{palette.white}",
        "glow": "rgba(244, 63, 94, 0.5)"
      },
      "success": {
        "default": "{palette.emerald.600}",
        "hover": "{palette.emerald.500}",
        "active": "{palette.emerald.400}",
        "text": "{palette.gray.950}",
        "glow": "rgba(16, 185, 129, 0.5)"
      },
      "neon": {
        "default": "linear-gradient(135deg, {palette.cyan.600}, {palette.blue.600})",
        "hover": "linear-gradient(135deg, {palette.cyan.500}, {palette.blue.500})",
        "active": "linear-gradient(135deg, {palette.cyan.400}, {palette.blue.400})",
        "text": "{palette.gray.950}",
        "glow": "rgba(6, 182, 212, 0.8)",
        "border": "{palette.cyan.400}"
      }
    },
    "border": {
      "default": "{palette.gray.700}",
      "light": "{palette.gray.600}",
      "medium": "{palette.gray.500}",
      "dark": "{palette.gray.400}",
      "focus": "{palette.cyan.400}",
      "error": "{palette.rose.400}",
      "success": "{palette.emerald.400}",
      "warning": "{palette.amber.400}",
      "neon": "{palette.cyan.400}",
      "neonGlow": "rgba(6, 182, 212, 0.6)"
    },
    "status": {
      "success": {
        "default": "{palette.emerald.500}",
        "light": "{palette.emerald.950}",
        "dark": "{palette.emerald.300}",
        "text": "{palette.emerald.300}",
        "glow": "rgba(16, 185, 129, 0.4)"
      },
      "error": {
        "default": "{palette.rose.500}",
        "light": "{palette.rose.950}",
        "dark": "{palette.rose.300}",
        "text": "{palette.rose.300}",
        "glow": "rgba(244, 63, 94, 0.4)"
      },
      "warning": {
        "default": "{palette.amber.400}",
        "light": "{palette.amber.950}",
        "dark": "{palette.amber.300}",
        "text": "{palette.amber.200}",
        "glow": "rgba(251, 191, 36, 0.4)"
      },
      "info": {
        "default": "{palette.cyan.400}",
        "light": "{palette.cyan.950}",
        "dark": "{palette.cyan.300}",
        "text": "{palette.cyan.300}",
        "glow": "rgba(6, 182, 212, 0.4)"
      }
    },
    "interactive": {
      "link": {
        "default": "{palette.cyan.400}",
        "hover": "{palette.cyan.300}",
        "visited": "{palette.violet.400}",
        "active": "{palette.cyan.200}",
        "glow": "rgba(6, 182, 212, 0.3)"
      },
      "focus": {
        "ring": "{palette.cyan.400}",
        "ringOffset": "{palette.gray.950}",
        "ringGlow": "rgba(6, 182, 212, 0.5)"
      }
    },
    "surface": {
      "elevated": "{palette.gray.800}",
      "raised": "{palette.gray.750}",
      "sunken": "{palette.gray.850}",
      "glass": "rgba(15, 23, 42, 0.4)",
      "neon": "rgba(6, 182, 212, 0.05)",
      "hologram": "linear-gradient(135deg, rgba(6, 182, 212, 0.1), rgba(139, 92, 246, 0.1))"
    },
    "gradient": {
      "cyberpunk": {
        "primary": "linear-gradient(135deg, {palette.cyan.600}, {palette.blue.600}, {palette.violet.600})",
        "secondary": "linear-gradient(135deg, {palette.rose.600}, {palette.orange.600})",
        "tertiary": "linear-gradient(135deg, {palette.emerald.600}, {palette.cyan.600})",
        "background": "linear-gradient(135deg, {palette.gray.950}, {palette.gray.900}, {palette.slate.900})"
      },
      "neon": {
        "cyan": "linear-gradient(135deg, {palette.cyan.400}, {palette.cyan.600})",
        "rose": "linear-gradient(135deg, {palette.rose.400}, {palette.rose.600})",
        "emerald": "linear-gradient(135deg, {palette.emerald.400}, {palette.emerald.600})"
      }
    }
  },
  "shadow": {
    "neon": {
      "cyan": "0 0 20px rgba(6, 182, 212, 0.6), 0 0 40px rgba(6, 182, 212, 0.4)",
      "rose": "0 0 20px rgba(244, 63, 94, 0.6), 0 0 40px rgba(244, 63, 94, 0.4)",
      "emerald": "0 0 20px rgba(16, 185, 129, 0.6), 0 0 40px rgba(16, 185, 129, 0.4)",
      "violet": "0 0 20px rgba(139, 92, 246, 0.6), 0 0 40px rgba(139, 92, 246, 0.4)"
    },
    "glow": {
      "soft": "0 0 10px rgba(6, 182, 212, 0.3)",
      "medium": "0 0 20px rgba(6, 182, 212, 0.5)",
      "strong": "0 0 30px rgba(6, 182, 212, 0.7)"
    }
  },
  "_notes": {
    "background": {
      "primary": "Fundo principal cyberpunk - quase preto com sutileza",
      "secondary": "Fundo secundário - cinza escuro profundo",
      "tertiary": "Fundo terciário - cinza médio escuro",
      "disabled": "Fundo desabilitado - intermediário sutil",
      "overlay": "Overlay com alta opacidade para imersão",
      "inverse": "Fundo invertido - claro para contraste",
      "glass": "Efeito glassmorfismo cyberpunk",
      "neon": "Fundo com sutil brilho neon"
    },
    "text": {
      "primary": "Texto principal branco/cinza claro",
      "secondary": "Texto secundário cinza médio",
      "tertiary": "Texto terciário cinza escuro",
      "disabled": "Texto desabilitado cinza médio",
      "inverse": "Texto invertido escuro",
      "onPrimary": "Texto sobre fundo primário",
      "onSecondary": "Texto sobre fundo secundário",
      "link": "Link neon cyan",
      "linkHover": "Link hover cyan mais claro",
      "neon": "Texto neon com brilho",
      "neonGlow": "Texto com efeito glow"
    },
    "button": {
      "primary": "Botão primário neon cyan com glow",
      "secondary": "Botão secundário escuro com borda cyan",
      "tertiary": "Botão terciário transparente com borda",
      "danger": "Botão perigo neon rose",
      "success": "Botão sucesso neon emerald",
      "neon": "Botão com gradiente cyberpunk"
    },
    "border": {
      "default": "Borda padrão cinza escuro",
      "light": "Borda clara cinza médio",
      "medium": "Borda média cinza",
      "dark": "Borda escura cinza claro",
      "focus": "Borda foco neon cyan",
      "error": "Borda erro neon rose",
      "success": "Borda sucesso neon emerald",
      "warning": "Borda aviso neon amber",
      "neon": "Borda com efeito neon",
      "neonGlow": "Borda com brilho neon"
    },
    "status": {
      "success": "Status sucesso neon emerald",
      "error": "Status erro neon rose",
      "warning": "Status aviso neon amber",
      "info": "Status informação neon cyan"
    },
    "interactive": {
      "link": "Links com efeitos neon",
      "focus": "Foco com anel glow cyan"
    },
    "surface": {
      "elevated": "Superfície elevada escura",
      "raised": "Superfície levantada média",
      "sunken": "Superfície rebaixada muito escura",
      "glass": "Efeito glass cyberpunk",
      "neon": "Superfície com brilho neon",
      "hologram": "Efeito holográfico cyberpunk"
    },
    "gradient": {
      "cyberpunk": "Gradientes temáticos cyberpunk",
      "neon": "Gradientes neon puros"
    },
    "shadow": {
      "neon": "Sombras neon coloridas",
      "glow": "Efeitos de brilho variados"
    }
  }
}
