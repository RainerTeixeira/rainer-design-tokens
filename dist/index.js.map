{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$description": "Tokens de opacidade - Níveis de transparência",
  "_comments": {
    "opacity": "Escala de valores de opacidade de 0 a 1"
  },
  "opacity": {
    "0": 0,
    "10": 0.1,
    "20": 0.2,
